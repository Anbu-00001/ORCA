<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET is requested so the app can REFRESH its advisory in
         harbour. It is not required for the app to work: the shell is in
         the APK and the advisory is in assets/localStorage, so with the
         permission denied or the radio off ORCA still answers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- LOCATION, for the maritime boundary watch (BoundaryWatchService).
         This is the one feature that justifies an APK at all: a background
         service comparing GPS against the real India-Sri Lanka IMBL and
         warning aloud, in Tamil, while the app is closed and the screen is
         off. No web page can do any part of that.

         It stays OFF until the crew turns it on. docs/MOBILE_APP.md §5 is
         explicit that boat tracks are personally identifying and
         commercially sensitive, and nothing here is uploaded anywhere —
         the position is compared against boundary geometry on the device
         and then discarded. ACCESS_BACKGROUND_LOCATION is deliberately
         NOT requested: a foreground service with a permanent notification
         does the job, and the crew can always see that it is running. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No SEND_SMS. The distress message is handed to the phone's own
         messaging app via ACTION_SENDTO, which needs no permission and
         puts the crew in the loop before anything is sent. Android 15
         hard-restricts SEND_SMS for sideloaded apps anyway, so a
         permission-based path would simply not work here. -->

    <!-- Speech recognition lives in another app; this declares that we
         intend to talk to it (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ORCA"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic is for the http://127.0.0.1:8000 dev
             backend reached over `adb reverse` only. The bundled assets
             themselves are served over https://appassets.androidplatform.net
             by WebViewAssetLoader. A real deployment pointing at a real
             backend should drop this and use https. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BoundaryWatchService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
