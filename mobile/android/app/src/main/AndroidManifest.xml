<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET is requested so the app can REFRESH its advisory in
         harbour. It is not required for the app to work: the shell is in
         the APK and the advisory is in assets/localStorage, so with the
         permission denied or the radio off ORCA still answers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- LOCATION, for the maritime boundary watch (BoundaryWatchService).
         This is the one feature that justifies an APK at all: a background
         service comparing GPS against the real India-Sri Lanka IMBL and
         warning aloud, in Tamil, while the app is closed and the screen is
         off. No web page can do any part of that.

         It stays OFF until the crew turns it on. docs/MOBILE_APP.md §5 is
         explicit that boat tracks are personally identifying and
         commercially sensitive, and nothing here is uploaded anywhere —
         the position is compared against boundary geometry on the device
         and then discarded. ACCESS_BACKGROUND_LOCATION is deliberately
         NOT requested: a foreground service with a permanent notification
         does the job, and the crew can always see that it is running. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- BOAT-TO-BOAT RELAY. Mobile signal stops ~15 km offshore, which is
         why ISRO issues satellite receivers. Boats meet each other out
         there, and their phones can see each other: BLE carries the 52 KB
         advisory between them. Nothing is uploaded anywhere and no boat is
         identified - the advertisement carries an age and a zone count,
         not a name. See FleetRelay.kt. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- DISTRESS. SEND_SMS, because the SOS must go out on ONE press.
         The previous design handed a pre-filled message to the phone's
         messaging app, which left the crew picking a recipient and
         pressing send: three actions, on a pitching deck, in the dark.

         Android 15 makes SEND_SMS a hard-restricted permission for a
         sideloaded app, so the toggle starts greyed out and a human must
         first allow it once under App info -> Allow restricted settings.
         ORCA detects that state and says exactly that, rather than
         failing quietly. See SosDispatch.kt.

         CALL_PHONE is for 1554, the Indian Coast Guard's distress line.
         It is a TELEPHONE number: ORCA used to open an SMS to it, which
         most likely delivered to nothing at all. It dials now. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Speech recognition lives in another app; this declares that we
         intend to talk to it (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ORCA"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic is for the http://127.0.0.1:8000 dev
             backend reached over `adb reverse` only. The bundled assets
             themselves are served over https://appassets.androidplatform.net
             by WebViewAssetLoader. A real deployment pointing at a real
             backend should drop this and use https. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BoundaryWatchService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Today's verdict on the home screen. The clearest thing in this
             app that a web client cannot do: no browser API can render live
             content on the Android launcher. A PWA shortcut is an icon. -->
        <receiver
            android:name=".VerdictWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_verdict_info" />
        </receiver>


        <!-- The volume-key panic watch. specialUse, declared honestly:
             this is not media playback and not location. It is a
             hardware-key listener for an emergency, which Android has no
             category for. -->
        <service
            android:name=".PanicService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Listens for a five-second volume-key hold to raise a maritime distress alert while the app is closed." />
        </service>

    </application>
</manifest>
