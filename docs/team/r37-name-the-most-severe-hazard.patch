diff --git a/tests/test_policy.py b/tests/test_policy.py
index 29b9f85..feaed6e 100644
--- a/tests/test_policy.py
+++ b/tests/test_policy.py
@@ -197,3 +197,55 @@ def test_policy_module_makes_no_llm_calls():
     forbidden = ["openai", "anthropic", "Claude(", "llm(", "chat.completions", "requests.get", "requests.post"]
     for token in forbidden:
         assert token.lower() not in source.lower(), f"policy.py must not contain {token!r}"
+
+
+# --- R-37: name the most severe hazard, not the first registered --------
+# AGENTS order is [eo, ocean_state, weather, hazard, geofence], so
+# weather_agent always precedes hazard_agent. With both above the 0.6
+# threshold, danger[0] named the wind and the 2.4 m sea state was never
+# mentioned. Measured on the 2026-08-28 cache: 4 of the 6 zones carrying
+# more than one danger reported the wrong hazard at 2.4 m waves.
+def _danger(name, risk, *, suggests_go=False, hard_deny=False):
+    return Finding(
+        agent_name=name, suggests_go=suggests_go, risk_level=risk,
+        hard_deny=hard_deny, reason=f"{name} reason",
+    )
+
+
+def test_r37_rule_2_names_the_most_severe_danger_not_the_first():
+    findings = [
+        _danger("eo_satellite_agent", 0.0, suggests_go=True),
+        _danger("weather_agent", 0.70),   # first in registration order
+        _danger("hazard_agent", 0.96),    # but this is the real danger
+    ]
+    decision = resolve(findings)
+    assert decision.action == "SAFER ALTERNATIVE"
+    assert decision.reason == "hazard_agent reason"
+    assert "hazard_agent" in decision.explanation
+
+
+def test_r37_rule_1_names_the_most_severe_hard_denial():
+    findings = [
+        _danger("hazard_agent", 0.80, hard_deny=True),
+        _danger("geofence_agent", 1.00, hard_deny=True),
+    ]
+    assert resolve(findings).reason == "geofence_agent reason"
+
+
+def test_r37_an_exact_tie_keeps_registration_order():
+    """max() returns the first maximum, so this is a strict refinement of
+    the old behaviour -- never a reshuffle of equally severe findings."""
+    findings = [
+        _danger("eo_satellite_agent", 0.0, suggests_go=True),
+        _danger("weather_agent", 0.80),
+        _danger("hazard_agent", 0.80),
+    ]
+    assert resolve(findings).reason == "weather_agent reason"
+
+
+def test_r37_single_danger_is_unaffected():
+    findings = [
+        _danger("eo_satellite_agent", 0.0, suggests_go=True),
+        _danger("weather_agent", 0.70),
+    ]
+    assert resolve(findings).reason == "weather_agent reason"
