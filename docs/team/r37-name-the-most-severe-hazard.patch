index 968819d..74610c2 100644
--- a/orca/policy.py
+++ b/orca/policy.py
@@ -46,9 +46,13 @@ def resolve(findings: list[Finding]) -> Decision:
         raise ValueError("resolve() requires at least one Finding; refusing to decide on no evidence")
 
     # Rule 1: any hard denial wins outright, unconditionally.
+    # R-37: when several findings deny, name the most severe rather than
+    # whichever agent happens to be registered first. max() returns the
+    # first maximum, so an exact tie keeps today's registration order and
+    # the change is a strict refinement, never a reshuffle.
     hard_denials = [f for f in findings if f.hard_deny]
     if hard_denials:
-        primary = hard_denials[0]
+        primary = max(hard_denials, key=lambda f: f.risk_level)
         return Decision(
             action="DO NOT GO",
             reason=primary.reason,
@@ -61,8 +65,16 @@ def resolve(findings: list[Finding]) -> Decision:
     danger = [f for f in findings if f.risk_level >= RISK_OVERRIDE_THRESHOLD]
 
     # Rule 2: opportunity contradicted by elevated risk -> safety wins.
+    # R-37: the MOST SEVERE danger, not the first in AGENTS order.
+    # weather_agent is registered before hazard_agent, so with 2.4 m waves
+    # (risk 0.96) and 27.9 km/h wind (0.70) this named the wind and never
+    # mentioned the sea state -- to a crew one step below the 2.5 m hard
+    # deny. Measured on the 2026-08-28 cache: 4 of the 6 zones carrying
+    # more than one danger reported the wrong hazard at 2.4 m.
+    # zone_summaries already applies exactly this rule ("a single hazard
+    # must not be diluted", R-18); the reason string now applies it too.
     if opportunity and danger:
-        primary_danger = danger[0]
+        primary_danger = max(danger, key=lambda f: f.risk_level)
         return Decision(
             action="SAFER ALTERNATIVE",
