# Copy to .env (git-ignored) and fill in real values. Never commit .env.
#
# Optional. Powers orca/agentic.py, the chatbot's agentic layer (LLM-
# assisted zone resolution + localized, grounded phrasing). Unset =
# ORCA runs exactly as it always has: fully offline, deterministic
# substring-match zone resolution, template phrasing (CLAUDE.md rule 8).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Provider (all optional; defaults are Groq) -------------------------
#
# The agentic layer speaks the OpenAI /chat/completions shape, which Groq,
# NVIDIA NIM, Cerebras, Together and OpenRouter all accept. Switching is
# these four variables and a restart -- no code change, no rebuild.
#
# Why you might: the free-tier TOKEN budget is what degrades a live demo.
# Groq allows ~8,000 tokens/min per model; ORCA sends ~1,700 per question
# across two models, so the ceiling is roughly 8 questions/minute. Past it
# every answer is still correct but becomes deterministic-only, which
# reads as a chatbot repeating itself. orca/agentic.py now backs off on a
# 429 and caches identical questions, which is what actually fixed it --
# a bigger quota is headroom on top of that, not a substitute for it.
#
# ORCA_LLM_API_KEY takes precedence over GROQ_API_KEY, so set it when you
# switch and the old vendor's key cannot be used by accident.
#
# NVIDIA NIM  (~40 req/min, shared across models; free NVIDIA Developer account)
#   ORCA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
#   ORCA_LLM_API_KEY=nvapi-...
#   ORCA_EXTRACTION_MODEL=meta/llama-3.1-8b-instruct
#   ORCA_COMPOSITION_MODEL=meta/llama-3.3-70b-instruct
#
# Cerebras  (larger token/min budget; narrower model list)
#   ORCA_LLM_BASE_URL=https://api.cerebras.ai/v1/chat/completions
#   ORCA_LLM_API_KEY=csk-...
#   ORCA_EXTRACTION_MODEL=gpt-oss-120b
#   ORCA_COMPOSITION_MODEL=gpt-oss-120b
#
# VERIFY BEFORE THE DEMO, on whichever provider you pick: extraction asks
# for strict JSON-schema structured output and support varies by provider
# AND by model. It is safe to vary -- extract_query_intent() re-validates
# every field against the real closed sets afterwards, so weak
# enforcement costs you fallbacks, never a fabricated zone or capability
# -- but "safe" is not the same as "working". Ask three questions and
# check agentic_used is true in the response.
#
# ORCA_LLM_BASE_URL=
# ORCA_LLM_API_KEY=
# ORCA_EXTRACTION_MODEL=
# ORCA_COMPOSITION_MODEL=

# --- Fallback provider (optional, and the actually useful bit) ----------
#
# Set these and a rate-limited primary stops mattering: the request moves
# to the second provider instead of falling back to template text. The
# quotas belong to different organisations, so they cannot exhaust
# together. Unset, there is exactly one provider and nothing changes.
#
# The simplest and most effective setup is a SECOND KEY FOR THE SAME
# PROVIDER -- a teammate's free Groq key. Leave the model names unset and
# they inherit the primary's.
#   ORCA_LLM_FALLBACK_API_KEY=gsk_...second_account...
#
# Or a different vendor entirely, in which case give it its own models:
#   ORCA_LLM_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
#   ORCA_LLM_FALLBACK_API_KEY=nvapi-...
#   ORCA_LLM_FALLBACK_EXTRACTION_MODEL=meta/llama-3.1-8b-instruct
#   ORCA_LLM_FALLBACK_COMPOSITION_MODEL=meta/llama-3.3-70b-instruct
#
# ORCA_LLM_FALLBACK_BASE_URL=
# ORCA_LLM_FALLBACK_API_KEY=
# ORCA_LLM_FALLBACK_EXTRACTION_MODEL=
# ORCA_LLM_FALLBACK_COMPOSITION_MODEL=
#
# Check headroom any time, including right before you present:
#   curl -s localhost:8000/health | python -m json.tool
# llm_quota reports remaining tokens and requests per provider and model,
# straight from the provider's own x-ratelimit-* headers.
